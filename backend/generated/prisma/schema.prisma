// Prisma v7 schema — URL is configured in prisma.config.ts, not here.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  avatarUrl String?
  googleId  String     @unique
  createdAt DateTime   @default(now())
  emailJobs EmailJob[]
}

model EmailJob {
  id          String    @id @default(cuid())
  subject     String
  body        String
  recipients  String[]
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("scheduled")
  error       String?
  bullJobId   String?   @unique
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
